# ===== Configuration du site — Carrière Humanitaire au Niger =====
# Sur le VPS, ce fichier se trouve ici : /opt/carriere-humanitaire/.env
# Après modification :  systemctl restart carriere-humanitaire

SITE_NAME=Carrière Humanitaire au Niger
# Rempli automatiquement par install.sh avec votre domaine :
SITE_URL=https://votre-domaine.com
LOGO_URL=/logo.png
CURRENCY=XOF
COUNTRY_CODE=NE
PAYMENT_METHODS=Nita, Amana ou Wave
# Paiement manuel : le client envoie l'argent puis saisit la référence ; vous validez dans /admin.
# Format : Moyen=numéro; Moyen=numéro   (un moyen sans numéro n'est pas affiché)
MANUAL_PAYMENT_ACCOUNTS=Nita=+22796464949; Amana=+22796464949; Wave=
MANUAL_PAYMENT_HOLDER=Jakfar Elhadji Yacoubou
MONTHLY_TARGET=1000000

WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbAipUQHgZWZmf7LfJ0M
FACEBOOK_URL=https://www.facebook.com/share/1duQYxrYat/
LINKEDIN_URL=
# Votre numéro WhatsApp de contact, format international sans + (ex : 22790000000)
SUPPORT_WHATSAPP=22796464949
# Identifiant Meta Pixel (publicités Facebook), facultatif
META_PIXEL_ID=

# ===== SECRETS — à remplir, ne jamais partager =====
# Mot de passe du tableau de bord /admin (choisissez-en un long)
ADMIN_PASSWORD=
# Identifiants CinetPay (tableau de bord CinetPay > Intégration)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
